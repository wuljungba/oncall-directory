# ── REAL Microsoft Entra sign-in (overrides .env) ──────────────────────────
# Copy this file to `.env.local` (gitignored) to enable REAL Entra login.
#
# `.env.local` takes precedence over `.env`, so this turns off dev auth WITHOUT
# editing `.env`. To return to dev auth, delete `.env.local` (or set
# VITE_DEV_AUTH=true in it).
#
# Where to get the values (Azure portal → App registrations):
#   VITE_AZURE_CLIENT_ID — "Application (client) ID" of your SPA registration
#   VITE_GOOGLE_CLIENT_ID — optional Google OAuth client ID; empty disables it
#
# IMPORTANT: the SPA registration must expose the backend scope
# `api://<api-client-id>/access_as_user` and it must be granted/consented,
# otherwise the API rejects the token (403). Backend must run with DevAuth
# disabled (see backend launch settings / README).

VITE_DEV_AUTH=false
VITE_AZURE_CLIENT_ID=your-spa-client-id
VITE_GOOGLE_CLIENT_ID=
