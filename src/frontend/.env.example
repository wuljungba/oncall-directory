# Microsoft Entra ID (Azure AD) — SPA uses PKCE, no client secret needed
# In multi-tenant mode, the tenant is resolved at sign-in (organizations endpoint)
VITE_AZURE_CLIENT_ID=your-spa-client-id

# Google OAuth 2.0 Client ID (optional — leave empty to disable Google sign-in)
# From Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Set VITE_DEV_AUTH=true to skip Entra ID auth during local development
# VITE_DEV_AUTH=true

# ── Testing REAL Microsoft Entra sign-in ───────────────────────────────────
# `.env` above is the day-to-day dev default (dev auth). To test a real
# Microsoft login, copy the block below into `.env.local` (gitignored — it
# takes precedence over `.env`) and fill in your real SPA client ID:
#
#   VITE_DEV_AUTH=false
#   VITE_AZURE_CLIENT_ID=<your real SPA client id>
#   VITE_GOOGLE_CLIENT_ID=
#
# The backend must also run with real JWT validation (DevAuth disabled) — see
# the backend launch settings. Delete `.env.local` to return to dev auth.
